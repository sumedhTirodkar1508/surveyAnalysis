# Next.js
DATABASE_URL=postgresql://user:password@host:5432/dbname     # Supabase session pooler
DIRECT_URL=postgresql://user:password@host:5432/dbname       # Supabase direct (for migrations)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-32-char-random-string

# Supabase (new key naming)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_STORAGE_BUCKET=survey-files

# Worker callback (used in Phase 4)
WORKER_CALLBACK_SECRET=replace-with-random-string

# Python worker (used in Phase 4)
PG_CONNECTION_STRING=postgresql://user:password@host:5432/dbname
OCR_PROVIDER=paddle
CHECKBOX_FILL_THRESHOLD=0.15
